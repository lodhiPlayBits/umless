# ${SERVER_NAME} is filled in by the nginx image from the environment (docker-compose.yml).

# Service names resolve on the compose network. keepalive reuses connections, which needs
# the empty Connection header in proxy-common.conf.
upstream umless_backend {
    # One uvicorn process (the JSON question store isn't safe across workers).
    server backend:8000 max_fails=3 fail_timeout=30s;
    keepalive 16;
}

upstream umless_frontend {
    server frontend:80 max_fails=3 fail_timeout=30s;
    keepalive 16;
}

# --- Plain HTTP: ACME challenge + redirect everything else to HTTPS ---
server {
    listen 80 default_server;
    server_name ${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# --- HTTPS: gateway in front of the frontend and the API ---
server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${SERVER_NAME};

    # A symlink to the Let's Encrypt cert, or to the self-signed fallback
    # (docker-entrypoint.d/15-certificate.sh picks one at startup).
    ssl_certificate     /etc/nginx/ssl/active/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/active/privkey.pem;
    include /etc/nginx/snippets/ssl-params.conf;
    include /etc/nginx/snippets/security-headers.conf;

    limit_conn conn_limit 20;

    # Raw audio body, up to the backend's 25 MB cap (a little slack so the backend,
    # not nginx, answers with its own 413 body). Deepgram may take up to 60 s.
    location = /api/transcriptions {
        limit_req zone=transcribe_limit burst=3 nodelay;
        client_max_body_size 26m;
        proxy_pass http://umless_backend;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location /api/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://umless_backend;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }

    # Everything else is the single-page app (the frontend container handles
    # index.html fallback and cache headers).
    location / {
        proxy_pass http://umless_frontend;
        include /etc/nginx/snippets/proxy-common.conf;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
