DEEPGRAM_API_KEY=
UMLESS_TRANSCRIBER=deepgram
# Optional: where questions are stored (relative paths are relative to backend/).
# UMLESS_DATA_FILE=data/questions.json
# Optional: store questions in MySQL instead of the file (one list per user). Setting DB_HOST
# switches it on; the other four, sign-in (CLERK_*) and the bucket (OCI_*) are then required. The Docker image runs the migrations
# on start; elsewhere run `alembic upgrade head` from backend/ first.
# DB_HOST=10.0.0.230
# DB_PORT=3306
# DB_USER=umless
# DB_PASSWORD=
# DB_NAME=umless
# Optional: Clerk sign-in (docs/adr/0003-clerk-auth.md). With a publishable key every API call
# but health needs a Clerk session token; list the origins the app is served from.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_AUTHORIZED_PARTIES=https://umless.in,http://localhost:5173
# Optional: the OCI Object Storage bucket for saved take transcripts, reached as this VM
# (instance principal; no keys). Without it takes are kept in memory until the server stops.
# OCI_NAMESPACE=bmej3eov9wnf
# OCI_BUCKET=bucket-20261024-1540
# OCI_REGION=ap-mumbai-1
