DEEPGRAM_API_KEY=
UMLESS_TRANSCRIBER=deepgram
# Optional: where questions are stored (relative paths are relative to backend/).
# UMLESS_DATA_FILE=data/questions.json
# Optional: store questions in MySQL instead of the file (one list per user). Setting DB_HOST
# switches it on; the other four, sign-in (CLERK_*), the bucket (OCI_*) and payments
# (RAZORPAY_*) are then required. The Docker image runs the migrations
# on start; elsewhere run `alembic upgrade head` from backend/ first.
# DB_HOST=10.0.0.230
# DB_PORT=3306
# DB_USER=umless
# DB_PASSWORD=
# DB_NAME=umless
# Optional: Clerk sign-in (docs/adr/0003-clerk-auth.md). With a publishable key every API call
# but health needs a Clerk session token; list the origins the app is served from.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_AUTHORIZED_PARTIES=https://umless.in,http://localhost:5173
# Optional: the OCI Object Storage bucket for saved take transcripts, reached as this VM
# (instance principal; no keys). Without it takes are kept in memory until the server stops.
# OCI_NAMESPACE=bmej3eov9wnf
# OCI_BUCKET=bucket-20261024-1540
# OCI_REGION=ap-mumbai-1
# Optional: paid practice time (docs/adr/0004-razorpay-billing.md). Without the keys nothing is
# metered. The webhook secret is the one set on the webhook in Razorpay's dashboard.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Redis for the transcription limits (docs/adr/0006-redis-limits.md); required with DB_HOST.
# The password is REDIS_PASSWORD from redis/.env. Without it the limits are kept in memory.
# REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0
# Optional: transcriptions per user per clock hour (default 30).
# UMLESS_TRANSCRIPTIONS_PER_HOUR=30
# Optional: DEBUG, INFO (default), WARNING or ERROR.
# UMLESS_LOG_LEVEL=INFO
