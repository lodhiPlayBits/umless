# Copy to backup/.env. docs/runbooks/backups.md has the setup.
# The database: ideally a read-only umless_backup user (SQL in the runbook); the app's own
# user from backend/.env also works.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=umless
# A private bucket only for backups (not the transcripts bucket), same namespace and region.
BACKUP_BUCKET=umless-backups
OCI_NAMESPACE=
OCI_REGION=ap-mumbai-1
# Optional: days of dumps to keep (the newest 7 are always kept), and when to run (UTC).
# BACKUP_KEEP_DAYS=30
# BACKUP_TIME_UTC=20:30
